{
  "name": "iot-monitor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "IoT Device Health & Security Monitoring Platform - API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "train": "tsx src/ml/train.ts",
    "typecheck": "tsc --noEmit",
