# Copy to .env and edit. Docker Compose reads it automatically.

# A long random string used to sign sign-in tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Password for the Postgres container (also used by the backend). Changing it after the first run
# requires resetting the volume:  docker compose down -v
POSTGRES_PASSWORD=iot

# Password for the MongoDB container (operational data). Changing it after the first run requires resetting its volume.
MONGO_PASSWORD=iot

# Turn the built-in device simulator off when only real devices report:
SIMULATOR=true

# Origin allowed to call the API from a browser (the dashboard URL)
CORS_ORIGIN=http://localhost:8080
